# Nothing derived from a game is ever committed: dumps, unpacked programs,
# generated C, traces, snapshots.
# dumps: a folder, or a link to one on another disk
/dumps
/build/
/out/
*.bin
*.iso
*.chd
*.img
*.gpr
*.rep/
*.cue
*.py1
*.py2
# ... nor a package or an archive left in the tree (a release's, a dump's), nor a Windows program
*.tar.xz
*.tar.gz
*.zip
*.7z
*.rar
*.exe
*.dll
__pycache__/
*.pyc
/compile_commands.json
*.core
/user/

# Local notes and backups, not for the repo
/local/
