# Nothing derived from a game is ever committed: dumps, unpacked programs,
# generated C, traces, snapshots.
# dumps: a folder, or a link to one on another disk
/dumps
/build/
/out/
*.bin
*.iso
*.chd
*.img
*.gpr
*.rep/
*.cue
*.py1
*.py2
# ... nor a package or an archive left in the tree (a release's, a dump's), nor a Windows program
*.tar.xz
*.tar.gz
*.zip
*.7z
*.rar
*.exe
*.dll
__pycache__/
*.pyc
/compile_commands.json
*.core
/user/

# hiraku-server's song names' packs (docs/SERVER.md, "Song names"): made from the owner's own
# games, never committed (a names folder at the top, or a pack in any folder called names)
/names/
**/names/*.json

# Local notes and backups, not for the repo
/local/

# the logo animation's exports (tools/data/logo/build_anim.py): baked into runtime/menu/logo.anim
/tools/data/logo/out/
