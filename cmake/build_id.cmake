# cmake -DSRC=<checkout> -DOUT=<file.cpp> -P build_id.cmake: hk::sys::build_id() (runtime/shell/sys.h),
# the checkout's commit as git names it, "+" when files differ from it; "unknown" without git. The file
# is rewritten only when that changes, so a build recompiles it only then. (safe.directory: a checkout
# another user owns, as in a workflow's container job, is refused by git otherwise, and every Windows
# release's programs said "unknown"; GITHUB_SHA: the workflow's own word, should git still fail.)
set(id "unknown")
find_program(GIT git)
if(GIT AND EXISTS "${SRC}/.git")
  execute_process(COMMAND "${GIT}" -c safe.directory=* -C "${SRC}" log -1 --format=%h\ %cs OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE
                  RESULT_VARIABLE r ERROR_QUIET)
  if(r EQUAL 0 AND head)
    set(id "${head}")
    execute_process(COMMAND "${GIT}" -c safe.directory=* -C "${SRC}" diff --quiet HEAD -- runtime launcher RESULT_VARIABLE dirty ERROR_QUIET)
    if(NOT dirty EQUAL 0)
      string(REPLACE " " "+ " id "${id}")
    endif()
  endif()
endif()
if(id STREQUAL "unknown" AND NOT "$ENV{GITHUB_SHA}" STREQUAL "")
  string(SUBSTRING "$ENV{GITHUB_SHA}" 0 7 id)
endif()
set(text "// generated by cmake/build_id.cmake\n#include \"shell/sys.h\"\nconst char *hk::sys::build_id() { return \"${id}\"; }\n")
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
endif()
if(NOT old STREQUAL text)
  file(WRITE "${OUT}" "${text}")
endif()
