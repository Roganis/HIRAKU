#: launcher/aboutdialog.cpp
msgctxt "AboutDialog"
msgid "SoftFloat 2b (Musashi's FPU)"
msgstr "SoftFloat 2b (la FPU de Musashi)"

#: launcher/aboutdialog.cpp
msgctxt "AboutDialog"
msgid "LZMA SDK (libchdr's LZMA decoder): public domain"
msgstr "LZMA SDK (le décodeur LZMA de libchdr) : domaine public"

#: launcher/aboutdialog.cpp
msgctxt "AboutDialog"
msgid "crt-guest-advanced-fast: GNU GPL v2 or later"
msgstr "crt-guest-advanced-fast : GNU GPL v2 ou ultérieure"

#: launcher/aboutdialog.cpp
msgctxt "AboutDialog"
