#: launcher/mainwindow.cpp
#, qt-format
msgctxt "MainWindow"
msgid "<p><b>First boot:</b> %1</p>"
msgstr "<p><b>Premier démarrage :</b> %1</p>"

#: launcher/mainwindow.cpp
msgctxt "MainWindow"
msgid "<p><b>The install cassette is in the slot</b> for the next start: the game installs itself from CD to flash. When it says the install is done (INFO 506), stop it and play again: it then boots with the game's cassette.</p>"
msgstr "<p><b>La cassette d'installation est dans le lecteur</b> pour le prochain lancement : le jeu s'installe du CD vers la mémoire flash. Quand il indique que l'installation est terminée (INFO 506), arrêtez-le et relancez-le : il démarre alors avec la cassette du jeu.</p>"

#: launcher/mainwindow.cpp
msgctxt "MainWindow"
msgid "<p><b>The install CD is in the drive</b> for the next start: the game installs itself from it. When it says the install is done, stop it and play again: it then boots from the game's CD.</p>"
msgstr "<p><b>Le CD d'installation est dans le lecteur</b> pour le prochain lancement : le jeu s'installe à partir de lui. Quand il indique que l'installation est terminée, arrêtez-le et relancez-le : il démarre alors sur le CD du jeu.</p>"

#: launcher/mainwindow.cpp
msgctxt "MainWindow"
msgid "<p><b>e-AMUSEMENT:</b> the next start installs the network unit's data from its CD (about 15 to 20 minutes of the game's time; hold Tab to fast-forward). When the game shows INSTALLATION COMPLETED, stop it: the unit is then fitted from the next start.</p>"
msgstr "<p><b>e-AMUSEMENT :</b> le prochain lancement installe les données de l'unité réseau depuis son CD (de 15 à 20 minutes environ, en temps du jeu ; maintenez Tab pour accélérer). Quand le jeu affiche INSTALLATION COMPLETED, arrêtez-le : l'unité est alors installée à partir du lancement suivant.</p>"

#: launcher/mainwindow.cpp
msgctxt "MainWindow"
msgid "<p><b>e-AMUSEMENT:</b> the network unit is fitted (Game menu). Turn e-AMUSEMENT on in the game's test mode; each guitar or drum kit has a card unit (Card in Controls). The server is HIRAKU's own, or the one in Settings &gt; e-AMUSEMENT.</p>"
msgstr "<p><b>e-AMUSEMENT :</b> l'unité réseau est installée (menu Jeu). Activez e-AMUSEMENT dans le mode test du jeu ; chaque guitare ou batterie a son lecteur de carte (Card dans Commandes). Le serveur est celui de HIRAKU, ou celui de Paramètres &gt; e-AMUSEMENT.</p>"

#: launcher/mainwindow.cpp
msgctxt "MainWindow"
msgid "<p><b>e-AMUSEMENT:</b> needs the cabinet's network unit, whose hard disk installs once from its CD: Game &gt; Install the e-AMUSEMENT network unit.</p>"
msgstr "<p><b>e-AMUSEMENT :</b> il faut l'unité réseau de la borne, dont le disque dur s'installe une fois depuis son CD : Jeu &gt; Installer l'unité réseau e-AMUSEMENT.</p>"

