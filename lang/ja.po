msgstr "ゲームの実行ファイル："

#: launcher/settingsdialog.cpp
msgctxt "SettingsDialog"
msgid "default: user/data in the HIRAKU folder"
msgstr "既定：HIRAKU フォルダー内の user/data"

#: launcher/settingsdialog.cpp
