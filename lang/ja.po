msgstr "Keyboardmania の MIDI 出力の楽器（曲が鍵盤を鳴らすときの音）。"

#: launcher/settingsdialog.cpp
msgctxt "SettingsDialog"
msgid "SoundFont:"
msgstr "SoundFont："

