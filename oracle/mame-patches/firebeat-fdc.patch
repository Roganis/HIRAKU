@@ -791,7 +793,8 @@ void upd765_family_device::fifo_push(uint8_t data, bool internal)
 	fifo[fifo_pos++] = data;
 	fifo_expected--;
 
-	int thr = (fifocfg & FIF_THR)+1;
+	// HIRAKU: as the chip's data sheet, a read asks for service when the FIFO holds 16 - <threshold> bytes
+	int thr = std::max(16 - ((fifocfg & FIF_THR)+1), 1);
 	if(!fifo_write && (!fifo_expected || fifo_pos >= thr || (fifocfg & FIF_DIS)))
 		enable_transfer();
 	if(fifo_write && (fifo_pos == 16 || !fifo_expected || (fifocfg & FIF_DIS)))
@@ -816,6 +819,12 @@ uint8_t upd765_family_device::fifo_pop(bool internal)
 	int thr = fifocfg & FIF_THR;
 	if(fifo_write && fifo_expected && (fifo_pos <= thr || (fifocfg & FIF_DIS)) && !tc_done)
 		enable_transfer();
+	// HIRAKU: a read's result phase, held back until its last bytes were taken (read_data_continue)
+	if(result_waits && !fifo_pos) {
+		floppy_info *fi = result_waits;
+		result_waits = nullptr;
+		read_data_continue(*fi);
+	}
 	return r;
 }
 
@@ -2120,6 +2129,12 @@ void upd765_family_device::read_data_continue(floppy_info &fi)
 
 		case COMMAND_DONE:
 			LOGSTATE("COMMAND_DONE\n");
+			// HIRAKU: as the chip's data sheet, "reads require the host to remove the remaining
+			// data so that the result phase may be entered"
+			if(fi.main_state == READ_DATA && fifo_pos && internal_drq) {
+				result_waits = &fi;
+				return;
+			}
 			main_phase = PHASE_RESULT;
 			result[0] = fi.st0;
 			result[1] = st1;
