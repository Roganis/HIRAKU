 	set_ds(select_multiplexed ? 0 : -1);
 
@@ -589,7 +590,8 @@ uint8_t upd765_family_device::msr_r()
 		break;
 	case PHASE_EXEC:
 		msr |= MSR_CB;
-		if((spec & SPEC_ND) && xfer_in_progress) {
+		// HIRAKU: as the chip's data sheet, the non-DMA bit is set for the whole execution phase
+		if(spec & SPEC_ND) {
 			msr |= MSR_EXM;
 			if(!fifo_write)
