+// SPDX-License-Identifier: GPL-3.0+
+// HIRAKU (local patch, not upstream): taps for running this emulator as a HIRAKU
+// machine core (runtime/python/ in HIRAKU). All are null unless a host sets them.
+#pragma once
+
+#include "common/Pcsx2Types.h"
+
+namespace Hiraku
+{
+	// CPU thread, at every vsync, before the frame limiter and before the vsync is
+	// posted to the GS thread (VMManager::Internal::VSyncOnCPUThread).
+	extern void (*vsync_cpu)();
+	// CPU thread, at every vsync, just after it is posted to the GS thread (and before
+	// input polling): the GS can now present this vsync's picture.
+	extern void (*vsync_posted)();
+	// EE thread, every output sample (48 kHz), after the Python 1 interface board's
+	// ADPCM is mixed in and after the DC filter: what the audio device would get.
+	extern void (*audio_sample)(float left, float right);
+	// GS thread, after each vsync's present: the displayed picture at the internal
+	// resolution, unscaled, RGBA8 (R in the low byte). nullptr/0x0 for a blank frame.
+	extern void (*gs_frame)(const u32* rgba, u32 width, u32 height);
+	// GS: true to draw every line of every frame. A game rendering for an interlaced TV may
+	// mask the lines of the field not shown (SCANMSK), leaving them a frame old; with this set,
+	// the GS ignores the mask, and each frame is a whole progressive picture (as at 480p).
+	extern bool full_frames;
+	// CPU thread (IOP time), each JAMMA output command the game sends to the Python 1
+	// interface board: its output latches (lamps, coin counters) in the payload. The board
+	// answers each one with an input report, so this is also the game's input poll.
+	extern void (*p1io_output)(const u32* payload, u32 quads);
+	// CPU thread (IOP time), each write the game makes to the Python 1 interface board's
+	// serial port (the card reader/writer and 10-key bus): true if the host answers it
+	// itself, with uart_reply, instead of the emulator's own devices.
+	extern bool (*uart_write)(const u8* data, u32 size);
+	// Queue bytes for the game to read from that serial port.
+	void uart_reply(const u8* data, u32 size);
+	// CPU thread (IOP time), each socket command the game sends the Python 1 interface board
+	// (which has the network port): channel 0-7, payload[0] the command. True if the host
+	// answers it itself: data first (net_write, to IOP memory), then the channel's 8-word
+	// status block (net_respond, words as the board writes them).
+	extern bool (*net_command)(u32 channel, const u32* payload, u32 quads);
+	void net_respond(u32 channel, const u32* words);
+	void net_write(u32 iop_address, const u8* data, u32 size);
+	bool iop_read(u32 iop_address, u8* data, u32 size);
+	// The PS2's own network adapter (DEV9 SMAP, Python 2's network port), when a host sets
+	// both: no host adapter is opened and no receive thread runs. eth_send gets each Ethernet
+	// frame the game sends (CPU thread, IOP time); eth_poll is asked for the host's frames for
+	// the game from SMAP's update (CPU thread, IOP time: deterministic), one per call, its size
+	// returned (0: none now).
+	extern void (*eth_send)(const u8* frame, u32 size);
+	extern u32 (*eth_poll)(u8* frame, u32 capacity);
+	// The PS2's hard disk (DEV9 ATA): true to write each sector run as the game sends it, on the
+	// CPU thread, instead of queuing it for the I/O thread, whose pace (host time) would decide
+	// when a flush or a waiting command completes.
+	extern bool sync_disk;
+	// CPU thread (IOP time), after the Python 1 interface board reads its hard disk (medium 0) or
+	// CF card (1): size bytes at offset, which the host may change before the game gets them
+	// (HIRAKU's mods, docs/MODS.md: byte ranges of the disk replaced as it's read).
+	extern void (*disk_read)(u32 medium, u64 offset, u8* data, u32 size);
+	// CPU thread (IOP time), each lamp output the game sends Python 2's P2IO board: a bank (0-3)
+	// and its 8 outputs. LAMP_OUT_ALL writes the four banks in turn.
+	extern void (*p2io_lamp)(u8 bank, u8 value);
+	// The P2IO's two serial ports (SCI 0-1: the e-amusement card readers on an ACIO bus, an EXTIO
+	// board). CPU thread (IOP time): each packet the game writes to one, as sent (escaped). The
+	// ports in p2io_sci_ports (bit n: port n) are the host's: the emulator's own device there gets
+	// nothing, and p2io_sci_read gives the bytes the game reads (up to capacity; how many).
+	extern void (*p2io_sci_write)(u8 port, const u8* data, u32 size);
+	extern u32 (*p2io_sci_read)(u8 port, u8* data, u32 capacity);
+	extern u8 p2io_sci_ports;
+} // namespace Hiraku
