+// HIRAKU: a * b + c rounded once (a fused multiply-add), the same on every build: the instruction
+// where the build's target has it, and elsewhere the same result from double arithmetic (checked
+// against the instruction in every rounding mode, with and without the EE's denormal flags).
+static inline float FusedMulAdd(float a, float b, float c)
+{
+#if defined(__FMA__) || defined(__aarch64__) || defined(_M_ARM64)
+	return std::fma(a, b, c);
+#else
+	// The product of two floats is exact as a double (24 x 24 bits). The sum is then rounded twice,
+	// to double and to float: rounding the double "to odd" makes the second rounding the only one.
+	const double p = static_cast<double>(a) * static_cast<double>(b);
+	const double cd = static_cast<double>(c);
+	double s = p + cd;
+	const double t = s - p;
+	const double err = (p - (s - t)) + (cd - t); // what the sum's rounding dropped
+	if (err != 0.0 && err == err)
+	{
+		u64 bits;
+		std::memcpy(&bits, &s, sizeof(bits));
+		if (!(bits & 1))
+		{
+			// one step toward the true sum (a double's bits grow with its magnitude)
+			bits += ((err > 0.0) == (s > 0.0)) ? 1 : static_cast<u64>(-1);
+			std::memcpy(&s, &bits, sizeof(bits));
+		}
+	}
+	return static_cast<float>(s);
+#endif
+}
