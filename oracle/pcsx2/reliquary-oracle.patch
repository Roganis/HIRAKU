+// HIRAKU oracle hook (local patch, not upstream): HK_FRAMEHASH=<file> appends
+// "frame ee_hash iop_hash" every HK_FRAMEHASH_EVERY vsyncs (default 60);
+// HK_STOP_FRAME=<n> ends the process at vsync n. Used to check that runs repeat.
+static void HirakuOracleVsync()
+{
+	static u64 s_hk_frame = 0;
+	static std::FILE* s_hk_file = nullptr;
+	static u64 s_hk_every = 0, s_hk_stop = 0;
+	static bool s_hk_init = false;
+	if (!s_hk_init)
+	{
+		s_hk_init = true;
+		if (const char* f = std::getenv("HK_FRAMEHASH"))
+			s_hk_file = std::fopen(f, "w");
+		const char* e = std::getenv("HK_FRAMEHASH_EVERY");
+		s_hk_every = e ? std::strtoull(e, nullptr, 10) : 60;
+		if (const char* st = std::getenv("HK_STOP_FRAME"))
+			s_hk_stop = std::strtoull(st, nullptr, 10);
+	}
+	s_hk_frame++;
+	auto fnv = [](const u8* p, size_t n) {
+		u64 h = 0xcbf29ce484222325ull;
+		const u64* q = reinterpret_cast<const u64*>(p);
+		for (size_t i = 0; i < n / 8; i++)
+			h = (h ^ q[i]) * 0x100000001b3ull;
+		return h;
+	};
+	if (s_hk_file && s_hk_every && (s_hk_frame % s_hk_every) == 0)
+	{
+		std::fprintf(s_hk_file, "%llu %016llx %016llx\n", (unsigned long long)s_hk_frame,
+			(unsigned long long)fnv(eeMem->Main, Ps2MemSize::MainRam),
+			(unsigned long long)fnv(iopMem->Main, Ps2MemSize::IopRam));
+		std::fflush(s_hk_file);
+	}
+	if (s_hk_stop && s_hk_frame >= s_hk_stop)
+	{
+		if (s_hk_file)
+			std::fclose(s_hk_file);
+		std::_Exit(0);
+	}
+}
