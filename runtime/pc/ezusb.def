; HIRAKU's ezusb.dll (ezusb.c): Konami's exports, by their C++ names
LIBRARY ezusb.dll
EXPORTS
    "?usbBootSecurity@@YAHPAEHHH@Z" = usb_boot_security
    "?usbBootSecurityAll@@YAHPAEHHH@Z" = usb_boot_security
    "?usbBootSecurityAllR@@YAHPAEHHH@Z" = usb_boot_security
    "?usbCheckAlive@@YAHXZ" = usb_check_alive
    "?usbCheckSecurity@@YAHPAEHHH@Z" = usb_check_security
    "?usbCheckSecurityEep@@YAHH@Z" = usb_check_security_eep
    "?usbCheckSecurityNew@@YAHH@Z" = usb_check_security_new
    "?usbCoinBlocker@@YAHH@Z" = usb_coin_blocker
    "?usbCoinGet2@@YAHPAUCoinParam@@@Z" = usb_coin_get2
    "?usbCoinGet@@YAHH@Z" = usb_coin_get
    "?usbCoinMeterDown@@YAHH@Z" = usb_coin_meter_down
    "?usbCoinMeterUp@@YAHH@Z" = usb_coin_meter_up
    "?usbCoinMode@@YAHH@Z" = usb_coin_mode
    "?usbCoinUp@@YAHH@Z" = usb_coin_up
    "?usbEepRead@@YAHXZ" = usb_eep_read
    "?usbEepReadDone@@YAHPAE@Z" = usb_eep_read_done
    "?usbEepTest@@YAHXZ" = usb_eep_test
    "?usbEepWrite@@YAHPAE@Z" = usb_eep_write
    "?usbEepWriteDone@@YAHXZ" = usb_eep_write_done
    "?usbEnd@@YAHXZ" = usb_end
    "?usbFactoryModeInit@@YAHPAE@Z" = usb_factory_mode_init
    "?usbFirmResult@@YAHXZ" = usb_firm_result
    "?usbGetError@@YAHPAD@Z" = usb_get_error
    "?usbGetKEYID@@YAHPAEH@Z" = usb_get_keyid
    "?usbGetMute@@YAHXZ" = usb_get_mute
    "?usbGetPCBID@@YAHPAE@Z" = usb_get_pcbid
    "?usbGetSecurity@@YAHHPAE@Z" = usb_get_security
    "?usbIsHiSpeed@@YAHXZ" = usb_is_hi_speed
    "?usbLamp@@YAHH@Z" = usb_lamp
    "?usbMute@@YAHH@Z" = usb_mute
    "?usbPadRead@@YAHPAK@Z" = usb_pad_read
    "?usbPadReadLast@@YAHPAE@Z" = usb_pad_read_last
    "?usbReadEepHistory@@YAHPAUEEP_HISTORY@@@Z" = usb_read_eep_history
    "?usbSecurityGetId@@YAHXZ" = usb_security_get_id
    "?usbSecurityGetIdDone@@YAHPAE@Z" = usb_security_get_id_done
    "?usbSecurityInit@@YAHXZ" = usb_security_init
    "?usbSecurityInitDone@@YAHXZ" = usb_security_init_done
    "?usbSecurityRead@@YAHXZ" = usb_security_read
    "?usbSecurityReadDone@@YAHPAE@Z" = usb_security_read_done
    "?usbSecuritySearch@@YAHXZ" = usb_security_search
    "?usbSecuritySearchDone@@YAHXZ" = usb_security_search_done
    "?usbSecuritySelect@@YAHH@Z" = usb_security_select
    "?usbSecuritySelectDone@@YAHXZ" = usb_security_select_done
    "?usbSecurityTest@@YAHH@Z" = usb_security_test
    "?usbSecurityWrite@@YAHPAE@Z" = usb_security_write
    "?usbSecurityWriteDone@@YAHXZ" = usb_security_write_done
    "?usbSetExtIo@@YAHH@Z" = usb_set_ext_io
    "?usbSetupEeprom@@YAHPAEHHH@Z" = usb_setup_eeprom
    "?usbSetupEepromNew@@YAHHPAEHHH@Z" = usb_setup_eeprom_new
    "?usbSetupSecurity@@YAHPAEHHH@Z" = usb_setup_security
    "?usbSetupSecurityComplete@@YAHPAEHHH@Z" = usb_setup_security
    "?usbSetupSecurityCompleteNew@@YAHHPAEHHH@Z" = usb_setup_security_new
    "?usbSetupSecurityNew@@YAHHPAEHHH@Z" = usb_setup_security_new
    "?usbStart@@YAHH@Z" = usb_start
    "?usbStartWithFile@@YAHPAD@Z" = usb_start_with_file
    "?usbWdtReset@@YAHXZ" = usb_wdt_reset
    "?usbWdtStart@@YAHH@Z" = usb_wdt_start
    "?usbWdtStartDone@@YAHXZ" = usb_wdt_start_done
    "?usbWdtStop@@YAHXZ" = usb_wdt_stop
    hk_avs_net
