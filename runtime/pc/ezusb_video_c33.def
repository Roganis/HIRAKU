; HIRAKU's ezusb_video.dll for the C33 cabinet: Konami's video board's exports, each forwarded to HIRAKU's
; ezusb.dll (ezusb_c33.c), which keeps both boards
LIBRARY ezusb_video.dll
EXPORTS
    usbAttrSet = ezusb.usbAttrSet
    usbAttrSetDone = ezusb.usbAttrSetDone
    usbDevelop = ezusb.usbDevelop
    usbDisplayOnOff = ezusb.usbDisplayOnOff
    usbDisplaySet = ezusb.usbDisplaySet
    usbDisplaySetDone = ezusb.usbDisplaySetDone
    usbFlashCheck = ezusb.usbFlashCheck
    usbFlashCheckAbort = ezusb.usbFlashCheckAbort
    usbFlashCheckGetBank = ezusb.usbFlashCheckGetBank
    usbFlashErase = ezusb.usbFlashErase
    usbFlashEraseAll = ezusb.usbFlashEraseAll
    usbFlashEraseAllDone = ezusb.usbFlashEraseAllDone
    usbFlashEraseDone = ezusb.usbFlashEraseDone
    usbFlashRead = ezusb.usbFlashRead
    usbFlashReadDone = ezusb.usbFlashReadDone
    usbFlashReset = ezusb.usbFlashReset
    usbFlashResetDone = ezusb.usbFlashResetDone
    usbFlashSelect = ezusb.usbFlashSelect
    usbFlashSign = ezusb.usbFlashSign
    usbFlashSignDone = ezusb.usbFlashSignDone
    usbFlashWrite = ezusb.usbFlashWrite
    usbFlashWriteDone = ezusb.usbFlashWriteDone
    usbFpgaCheck = ezusb.usbFpgaCheck
    usbFpgaCheckDone = ezusb.usbFpgaCheckDone
    usbFpgaInit = ezusb.usbFpgaInit
    usbFpgaInitDone = ezusb.usbFpgaInitDone
    usbFpgaWrite = ezusb.usbFpgaWrite
    usbFpgaWriteDone = ezusb.usbFpgaWriteDone
    usbHeadSet = ezusb.usbHeadSet
    usbHeadSetDone = ezusb.usbHeadSetDone
    usbI2cChipSel = ezusb.usbI2cChipSel
    usbI2cPercent = ezusb.usbI2cPercent
    usbI2cSet = ezusb.usbI2cSet
    usbI2cWrite = ezusb.usbI2cWrite
    usbI2cWriteDone = ezusb.usbI2cWriteDone
    usbPaletteBank = ezusb.usbPaletteBank
    usbPaletteSet = ezusb.usbPaletteSet
    usbPaletteSetDone = ezusb.usbPaletteSetDone
    usbScaleSet = ezusb.usbScaleSet
    usbScaleSetDone = ezusb.usbScaleSetDone
    usbScrollSet = ezusb.usbScrollSet
    usbScrollSetDone = ezusb.usbScrollSetDone
    usbSioRead = ezusb.usbSioRead
