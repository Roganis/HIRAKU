    usbVPadRead = ezusb.usbVPadRead
    usbVStart = ezusb.usbVStart
    usbVStartWithFile = ezusb.usbVStartWithFile
    usbVWdtReset = ezusb.usbVWdtReset
    usbVWdtStart = ezusb.usbVWdtStart
    usbVWdtStartDone = ezusb.usbVWdtStartDone
    usbVWdtStop = ezusb.usbVWdtStop
    usbVramBank = ezusb.usbVramBank
    usbVramRead = ezusb.usbVramRead
    usbVramReadDone = ezusb.usbVramReadDone
    usbVramReadRect = ezusb.usbVramReadRect
    usbVramReadRectDone = ezusb.usbVramReadRectDone
